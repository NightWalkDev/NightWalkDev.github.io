---
interface Props {
  label: string;
  href: string;
  icon: 'mail' | 'person' | 'code' | 'play' | 'music' | 'link';
  color: string;
}

const { label, href, icon, color } = Astro.props;
const paths: Record<Props['icon'], string> = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M4 7l8 6 8-6"/>',
  person: '<circle cx="12" cy="8.5" r="3.6"/><path d="M5 20c.8-4.2 3.8-6.2 7-6.2s6.2 2 7 6.2"/>',
  code: '<path d="M8 7l-5 5 5 5M16 7l5 5-5 5"/>',
  play: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M10 9l5 3-5 3z"/>',
  music: '<path d="M9 18V6l10-2v12"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="16.5" cy="16" r="2.5"/>',
  link: '<path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1"/>',
};
const external = !href.startsWith('#') && !href.startsWith('/');
---

<a class="rl" href={href} style={`--rc: ${color}`} aria-label={external ? `${label} (opens outside this site)` : label} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener' : undefined}>
  <span class="rl-c">
    <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke={color} stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={paths[icon]} /></svg>
    {external && (
      <span class="rl-ext" aria-hidden="true">
        <svg width="10" height="10" viewBox="0 0 24 24"><path d="M8 16L16 8M9 8h7v7" fill="none" stroke="#141110" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
    )}
  </span>
  <span>{label}</span>
</a>
