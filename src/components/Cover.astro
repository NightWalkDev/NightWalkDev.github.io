---
interface Props {
  src?: string;
  alt?: string;
  clip?: string;
}

const { src, alt = '', clip } = Astro.props;
const clipIsGif = clip?.toLowerCase().endsWith('.gif');
---

<div class="img">
  {src ? (
    <img src={src} alt={alt} loading="lazy" />
  ) : (
    <svg viewBox="0 0 160 100" preserveAspectRatio="xMidYMid slice" aria-hidden="true" shape-rendering="crispEdges">
      <rect width="160" height="100" style="fill: var(--panel2)" />
      <rect x="40" y="34" width="28" height="28" fill="none" stroke-width="5" style="stroke: var(--amber)" />
      <path d="M96 32h8v8h8v8h8v8h-40v-8h8v-8h8z" style="fill: var(--crimson)" />
      <rect x="20" y="70" width="12" height="12" style="fill: var(--mint)" />
      <rect x="130" y="18" width="8" height="8" style="fill: var(--cream)" />
    </svg>
  )}
  {clip && (clipIsGif
    ? <img class="hover-clip" data-clip={clip} alt="" aria-hidden="true" />
    : <video class="hover-clip" data-clip={clip} muted loop playsinline preload="none" aria-hidden="true"></video>)}
</div>

<script>
  const canHover = matchMedia('(hover: hover)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLImageElement | HTMLVideoElement>('.hover-clip[data-clip]').forEach((clip) => {
    const frame = clip.parentElement!;
    const card = clip.closest('.node') ?? frame;
    if (!canHover) return clip.remove();

    card.addEventListener('mouseenter', () => {
      if (!clip.getAttribute('src')) clip.setAttribute('src', clip.dataset.clip!);
      frame.classList.add('is-playing');
      if (clip instanceof HTMLVideoElement) clip.play().catch(() => frame.classList.remove('is-playing'));
    });
    card.addEventListener('mouseleave', () => {
      frame.classList.remove('is-playing');
      if (clip instanceof HTMLVideoElement) {
        clip.pause();
        clip.currentTime = 0;
      }
    });
  });
</script>
