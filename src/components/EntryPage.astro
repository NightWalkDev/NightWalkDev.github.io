---
import Base from '../layouts/Base.astro';
import Node from './Node.astro';
import Preview3D from './Preview3D.astro';
import Contact from './Contact.astro';
import { site } from '../lib/site';
import { resolveColor } from '../lib/colors';
import { youtubeEmbedUrl } from '../lib/youtube';

interface Props {
  title: string;
  color: string;
  facts: { label: string; value: string }[];
  cover?: string;
  coverAlt?: string;
  model?: string;
  trailer?: string;
  links: { label: string; href: string }[];
  backHref: string;
  backLabel: string;
}

const { title, color, facts, cover, coverAlt = '', model, trailer, links, backHref, backLabel } = Astro.props;
const { bg, on } = resolveColor(color);
const preview = model ? { ...site.preview, title: 'Model', label: model.split('/').pop() ?? '', scene: 'model' as const, model } : null;
---

<Base title={`${title} · ${site.hero.name}`}>
  <main class="wrap">
    <div class="page-head">
      <a class="back" href={backHref}>← {backLabel}</a>
      <h1 class="display">{title}</h1>
      <div class="page-meta">
        <span class="chip" style={`background: ${bg}; color: ${on}`}>{facts[0]?.value}</span>
        {facts.slice(1).map((f) => <span class="chip">{f.value}</span>)}
      </div>
    </div>
    <div class="page-grid">
      <article>
        {trailer ? (
          <iframe class="page-cover" src={youtubeEmbedUrl(trailer)} title={`${title} trailer`} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="width: 100%; display: block; border: 0; box-shadow: 0 0 0 2px var(--shadow), 6px 6px 0 var(--shadow)"></iframe>
        ) : cover && <img class="page-cover" src={cover} alt={coverAlt} style="width: 100%; object-fit: cover; display: block; box-shadow: 0 0 0 2px var(--shadow), 6px 6px 0 var(--shadow)" />}
        <div class="prose"><slot /></div>
      </article>
      <aside class="side">
        <Node title="Details" color={color}>
          {facts.map((f) => <div class="row"><span class="k">{f.label}</span>{f.value}</div>)}
        </Node>
        {preview && <Preview3D config={preview} />}
        {links.length > 0 && (
          <Node title="Links" color="panel">
            <div style="padding: 12px 14px 16px; display: flex; flex-direction: column; gap: 10px">
              {links.map((l) => <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label} ↗</a>)}
            </div>
          </Node>
        )}
      </aside>
    </div>
    <div class="page-end">
      <Contact />
      <p class="footer">{site.footer}</p>
    </div>
  </main>
</Base>
