---
import { site } from '../lib/site';

const onHome = Astro.url.pathname === '/';
const href = (target: string) => (target.startsWith('#') && !onHome ? '/' + target : target);
---

<header class="top">
  <a href="/" class="logo"><span class="logo-mark" aria-hidden="true"></span>{site.hero.name}</a>
  <nav aria-label="Main">
    {site.nav.map((item) => <a class="nav" href={href(item.href)}>{item.label}</a>)}
  </nav>
</header>
