---
import { site } from '../lib/site';

const onHome = Astro.url.pathname === '/';
// Links to the contact box stay on the current page: every page has one.
const onEveryPage = '#' + site.contact.id;
const href = (target: string) => (target.startsWith('#') && !onHome && target !== onEveryPage ? '/' + target : target);
---

<div class="topbar">
<header class="top">
  <a href="/" class="logo"><span class="logo-mark" aria-hidden="true"></span>{site.hero.name}</a>
  <nav aria-label="Main">
    {site.nav.map((item) => <a class="nav" href={href(item.href)} aria-current={item.href.startsWith('/') && Astro.url.pathname.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
  </nav>
</header>
</div>
