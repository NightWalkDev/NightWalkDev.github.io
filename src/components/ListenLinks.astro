---
import ScreenButton from './ScreenButton.astro';
import { listenLinks } from '../lib/music';

interface Props {
  links: Parameters<typeof listenLinks>[0];
}

const links = listenLinks(Astro.props.links);
---

{links.length > 0 && (
  <div class="btn-row-links" style="gap: 18px">
    {links.map((l) => <ScreenButton label={l.label} href={l.href} icon={l.icon} color={l.color} size="small" />)}
  </div>
)}
