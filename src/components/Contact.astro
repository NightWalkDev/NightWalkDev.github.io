---
import { site } from '../lib/site';
import Node from './Node.astro';
import RoundLink from './RoundLink.astro';

const { contact } = site;
---

<section id={contact.id} style="max-width: 700px; scroll-margin-top: 16px" aria-label={contact.title}>
  <Node title={contact.title} color={contact.color}>
    <div style="padding: 20px; display: flex; flex-direction: column; gap: 18px">
      <div class="rl-row">
        {contact.links.map((l) => <RoundLink {...l} />)}
      </div>
      {contact.text && <p style="margin: 0; font-size: 15px; color: var(--dim)">{contact.text}</p>}
    </div>
  </Node>
</section>
