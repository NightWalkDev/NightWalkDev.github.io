---
import { resolveColor } from '../lib/colors';

interface Props {
  id: string;
  title: string;
  note?: string;
  color?: string;
}

const { id, title, note, color } = Astro.props;
const { bg, on } = resolveColor(color, 'cream');
---

<section id={id} class="cbox" style={`--cc: ${bg}; --co: ${on}`}>
  <h2 class="cbox-t" style="margin: 0"><span>{title}</span>{note && <small>{note}</small>}</h2>
  <slot />
</section>
