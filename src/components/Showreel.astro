---
interface Props {
  id: string;
  title: string;
  note?: string;
  image?: string;
  youtube?: string;
}

const { id, title, note, image, youtube } = Astro.props;
---

<section id={id} class="node" aria-label={title}>
  <div class="node-h" style="--hc: var(--panel2); --ho: var(--ink)">{title}{note && <small>{note}</small>}</div>
  <div class="reel-frame">
    {youtube ? (
      <iframe src={`https://www.youtube-nocookie.com/embed/${youtube}`} title={title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
    ) : (
      <>
        {image && <img class="pix" src={image} alt="" loading="lazy" />}
        <div class="scan" aria-hidden="true"></div>
        <span class="osd" aria-hidden="true" style="position: absolute; left: 16px; top: 12px; z-index: 8">PLAY ▶</span>
        <span class="display chroma reel-title">{title}</span>
      </>
    )}
  </div>
</section>
